{
  "manifest_version": 3,
  "name": "ZapFlow - WhatsApp Automation",
  "version": "3.4.0",
  "description": "Injete mensagens, áudios, mídias e documentos nas conversas do WhatsApp Web — sincronizado com o painel ZapFlow",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wa_config.js",
        "wppconnect-wa.js",
        "wa_engine.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "config.js",
        "supabase.min.js",
        "content-ui.js",
        "content.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
